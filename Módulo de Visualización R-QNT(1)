{"cells":[{"cell_type":"code","source":["# Importaciones necesarias para la simulación y visualización R-QNT\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from mpl_toolkits.mplot3d import Axes3D\n","from matplotlib import animation\n","# Marching cubes de scikit-image es esencial para las isosuperficies 3D\n","from skimage.measure import marching_cubes\n","# Numba para aceleración de cálculos\n","from numba import jit\n","# Para mostrar la animación en Jupyter/Colab\n","from IPython.display import HTML\n","\n","# --- Funciones de Simulación y Visualización (Adaptadas del Usuario) ---\n","\n","# Aceleramos el cálculo de densidad ya que es el cuello de botella potencial.\n","@jit(nopython=True)\n","def calcular_densidad_jit(estados_A, estados_B):\n","    \"\"\"Calcula la densidad combinada |A|^2 + |B|^2 de forma eficiente.\"\"\"\n","    # Nota: np.abs(z)**2 es igual a (np.conj(z) * z).real. Usamos np.abs para claridad.\n","    return np.abs(estados_A)**2 + np.abs(estados_B)**2\n","\n","def visualizar_red_3d(estados_A, estados_B, tiempos, nivel=0.05, frames=9):\n","    \"\"\"\n","    Visualiza la densidad combinada A+B como isosuperficie 3D en múltiples snapshots.\n","\n","    :param estados_A: Array 3D complejo de estados A [tiempo, x, y, z]\n","    :param estados_B: Array 3D complejo de estados B [tiempo, x, y, z]\n","    :param tiempos: Array de tiempos de la simulación.\n","    :param nivel: Umbral para la densidad de Marching Cubes.\n","    :param frames: Cantidad de snapshots a mostrar.\n","    \"\"\"\n","    print(\"\\n--- Generando Visualización 3D en Snapshots ---\")\n","    fig = plt.figure(figsize=(18, 12))\n","\n","    # Configuramos el estilo para un mejor contraste visual\n","    plt.style.use('dark_background')\n","\n","    N_t = estados_A.shape[0]\n","    indices = np.linspace(0, N_t-1, frames, dtype=int)\n","\n","    for i, idx in enumerate(indices):\n","        # Usamos subplot en 3D\n","        ax = fig.add_subplot(3, 3, i+1, projection='3d')\n","\n","        # Cálculo de la densidad total optimizado\n","        densidad = calcular_densidad_jit(estados_A[idx], estados_B[idx])\n","\n","        # Extraer isosuperficie\n","        try:\n","            verts, faces, _, _ = marching_cubes(densidad, level=nivel)\n","            # Normalizamos las coordenadas a un rango de 0 a 10 para visualización\n","            verts = verts / (densidad.shape[0] - 1) * 10\n","\n","            ax.plot_trisurf(verts[:, 0], verts[:, 1], faces, verts[:, 2],\n","                            color='cyan', alpha=0.7, edgecolor='none',\n","                            antialiased=True, lw=0.1)\n","        except ValueError:\n","            # Manejo de error si Marching Cubes no encuentra la superficie\n","            ax.text(5, 5, 5, f\"Densidad baja en t={tiempos[idx]:.2e}\", color='red')\n","\n","        # Configuraciones de eje\n","        ax.set_title(f't = {tiempos[idx]:.2e} s', color='white', fontsize=10)\n","        ax.set_xlim(0, 10); ax.set_ylim(0, 10); ax.set_zlim(0, 10)\n","        ax.set_xticks([]); ax.set_yticks([]); ax.set_zticks([]) # Ocultar ticks para limpieza\n","        ax.view_init(30, 45)\n","        ax.grid(False)\n","\n","    fig.suptitle('Evolución 3D de la Densidad Cuántica Combinada (Isosuperficie)', fontsize=16, color='yellow')\n","    plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n","    plt.show()\n","\n","def animar_red_3d(estados_A, estados_B, tiempos, nivel=0.05):\n","    \"\"\"\n","    Genera una animación 3D de la evolución de la isosuperficie de densidad.\n","\n","    :return: Objeto FuncAnimation de Matplotlib.\n","    \"\"\"\n","    print(\"\\n--- Generando Objeto de Animación 3D (Puede tardar en calcular y mostrar) ---\")\n","\n","    fig = plt.figure(figsize=(10, 8))\n","    plt.style.use('dark_background')\n","    ax = fig.add_subplot(111, projection='3d')\n","    ax.set_xlabel('x'); ax.set_ylabel('y'); ax.set_zlabel('z')\n","    ax.set_xlim(0, 10); ax.set_ylim(0, 10); ax.set_zlim(0, 10)\n","    ax.set_xticks([]); ax.set_yticks([]); ax.set_zticks([])\n","    ax.set_title('Evolución 3D R-QNT', color='yellow')\n","    ax.view_init(30, 45)\n","\n","    N_t = estados_A.shape[0]\n","\n","    def update(frame):\n","        ax.clear()\n","        ax.set_xlabel('x'); ax.set_ylabel('y'); ax.set_zlabel('z')\n","        ax.set_xlim(0, 10); ax.set_ylim(0, 10); ax.set_zlim(0, 10)\n","        ax.set_xticks([]); ax.set_yticks([]); ax.set_zticks([])\n","        ax.set_title(f't = {tiempos[frame]:.2e} s', color='white')\n","\n","        densidad = calcular_densidad_jit(estados_A[frame], estados_B[frame])\n","\n","        try:\n","            verts, faces, _, _ = marching_cubes(densidad, level=nivel)\n","            verts = verts / (densidad.shape[0] - 1) * 10\n","\n","            # Usamos plot_trisurf para dibujar la malla 3D\n","            ax.plot_trisurf(verts[:, 0], verts[:,1], faces, verts[:,2],\n","                            color='cyan', alpha=0.7, edgecolor='none', antialiased=True)\n","        except ValueError:\n","             # Si no hay superficie, no dibujamos nada\n","            pass\n","\n","        ax.view_init(30, 45 + frame * 0.5) # Pequeño giro para efecto dinámico\n","        # Retornamos un objeto (en este caso, la figura misma)\n","        return fig,\n","\n","    # Configuramos el formato para Colab/Jupyter y generamos la animación\n","    anim = animation.FuncAnimation(fig, update, frames=N_t, interval=100, blit=False, repeat=True)\n","\n","    # Es crucial cerrar la figura de Matplotlib para evitar que se muestre como un plot estático\n","    plt.close(fig)\n","\n","    return anim\n","\n","def espectro_fuerzas(C_final, dx):\n","    \"\"\"\n","    Calcula el power spectrum 3D de C y visualiza un slice 2D centrado.\n","    :param C_final: Campo escalar C en el último tiempo [x, y, z].\n","    :param dx: Separación espacial entre puntos de la red.\n","    :return: Array de frecuencias (1D) y array de power spectrum (3D).\n","    \"\"\"\n","    print(\"\\n--- Calculando Espectro de Fuerzas (Power Spectrum) ---\")\n","\n","    # 1. Transformada Rápida de Fourier 3D\n","    C_fft = np.fft.fftn(C_final)\n","    # 2. Densidad Espectral de Potencia (Power Spectral Density)\n","    C_ps = np.abs(C_fft)**2\n","    # 3. Frecuencias espaciales (k)\n","    freqs = np.fft.fftfreq(C_final.shape[0], d=dx)\n","\n","    # --- Visualización 2D (Slice) ---\n","    fig = plt.figure(figsize=(10, 8))\n","    plt.style.use('dark_background')\n","    ax = fig.add_subplot(111)\n","\n","    # Centramos el espectro en k=0\n","    ps_slice = np.fft.fftshift(C_ps[:, :, C_final.shape[2] // 2])\n","\n","    # Crear los ejes de frecuencia centrados (k_x, k_y)\n","    k_x = np.fft.fftshift(freqs)\n","    k_y = np.fft.fftshift(freqs)\n","    X, Y = np.meshgrid(k_x, k_y)\n","\n","    # Usamos escala logarítmica para ver mejor la distribución de potencia\n","    log_ps = np.log10(ps_slice / np.max(ps_slice) + 1e-10)\n","\n","    c = ax.pcolormesh(X, Y, log_ps, cmap='inferno')\n","    fig.colorbar(c, ax=ax, label='Log10(Potencia Normalizada)')\n","\n","    ax.set_title(f'Espectro de Potencia (Slice k_z=0) del Campo C (dx={dx:.3f})', color='yellow')\n","    ax.set_xlabel('Frecuencia Espacial $k_x$'); ax.set_ylabel('Frecuencia Espacial $k_y$')\n","    plt.tight_layout()\n","    plt.show()\n","\n","    return freqs, C_ps\n","\n","def correlacion_AB(A, B):\n","    \"\"\"\n","    Calcula correlación espacial (lag 1D de ejemplo) entre A y B en el tiempo final.\n","    :param A: Estado final A [x, y, z].\n","    :param B: Estado final B [x, y, z].\n","    :return: Array de correlación normalizada.\n","    \"\"\"\n","    print(\"\\n--- Calculando Correlación Espacial A-B ---\")\n","\n","    # Aplanamos la parte real de los estados\n","    A_flat = np.real(A).flatten()\n","    B_flat = np.real(B).flatten()\n","\n","    # Calculamos la correlación cruzada completa\n","    corr = np.correlate(A_flat, B_flat, mode='full')\n","\n","    # Normalizamos para que el máximo sea 1\n","    corr_normalized = corr / np.max(np.abs(corr))\n","\n","    # Definimos los 'lags' espaciales\n","    lags = np.arange(-len(A_flat) + 1, len(A_flat))\n","\n","    # --- Visualización ---\n","    fig, ax = plt.subplots(figsize=(10, 5))\n","    plt.style.use('dark_background')\n","    ax.plot(lags, corr_normalized, color='lime', linewidth=2)\n","\n","    # Destacamos el lag 0 (correlación perfecta si las estructuras coinciden)\n","    ax.axvline(0, color='red', linestyle='--', alpha=0.6, label='Lag Cero')\n","\n","    ax.set_title('Correlación Cruzada Espacial (Real A vs Real B)', color='yellow')\n","    ax.set_xlabel('Lag Espacial (Índices de Puntos de Red)'); ax.set_ylabel('Correlación Normalizada')\n","    ax.legend()\n","    ax.grid(True, linestyle=':', alpha=0.5)\n","    plt.tight_layout()\n","    plt.show()\n","\n","    return corr_normalized\n","\n","# --- Bloque de Ejecución (Demo con Datos Mock) ---\n","\n","def simular_datos_rqnt(N=20, T=50, L=10, dt=1e-4):\n","    \"\"\"Genera datos de simulación mock para la demo.\"\"\"\n","    print(\"Generando datos mock de la red (N={}^3, T={})...\".format(N, T))\n","\n","    # Parámetros espaciales\n","    x = np.linspace(0, L, N, endpoint=False)\n","    X, Y, Z = np.meshgrid(x, x, x, indexing='ij')\n","\n","    # Campo C (Fuerza emergente) - Mock: Una perturbación esférica con estructura\n","    R_sq_C = (X - L/2)**2 + (Y - L/2)**2 + (Z - L/2)**2\n","    C_final = np.exp(-R_sq_C / 5.0) * (1 + 0.5 * np.cos(X * 2*np.pi/L) * np.sin(Z * 2*np.pi/L))\n","\n","    # Evolución temporal (Mock: Dos paquetes de onda interactuando/moviéndose)\n","    tiempos = np.arange(0, T) * dt\n","    sigma_start = 1.0 # Ancho inicial del paquete\n","    k_vector_A = (1, 0.5, 0) # Vector de momento A\n","    k_vector_B = (-1, 0, 0.5) # Vector de momento B\n","\n","    estados_A = np.zeros((T, N, N, N), dtype=np.complex128)\n","    estados_B = np.zeros((T, N, N, N), dtype=np.complex128)\n","\n","    for t in range(T):\n","        sigma = sigma_start + t * dt * 5.0 # Dispersión\n","\n","        # Paquete A: Movimiento + oscilación\n","        center_x_A = L/2 + k_vector_A[0] * t * dt * 50\n","        R_sq_A = ((X - center_x_A) % L)**2 + (Y - L/2)**2 + (Z - L/2)**2\n","        gauss_A = np.exp(-R_sq_A / (2 * sigma**2))\n","        estados_A[t] = gauss_A * np.exp(1j * (k_vector_A[0]*X + k_vector_A[1]*Y))\n","\n","        # Paquete B: Movimiento en dirección opuesta y más disperso\n","        center_x_B = L/2 + k_vector_B[0] * t * dt * 50\n","        R_sq_B = ((X - center_x_B) % L)**2 + (Y - L/2)**2 + (Z - L/2)**2\n","        gauss_B = np.exp(-R_sq_B / (3 * sigma**2))\n","        # Añadimos una pequeña interacción (por ejemplo, decaimiento)\n","        estados_B[t] = 0.5 * gauss_B * np.exp(-t * dt / 0.005)\n","\n","    print(\"Datos mock generados. Listos para el análisis.\")\n","    return estados_A, estados_B, C_final, tiempos, L/N # Devuelve dx (separación espacial)\n","\n","# --- Ejecución Principal ---\n","if __name__ == '__main__':\n","    # 1. Simulación de los datos\n","    N_GRID = 20  # Tamaño de la red (20x20x20)\n","    N_TIME = 50  # Pasos de tiempo\n","\n","    E_A, E_B, C_final, Tiempos, dx = simular_datos_rqnt(N=N_GRID, T=N_TIME)\n","\n","    # 2. Visualización 3D en Snapshots\n","    # Usamos un nivel bajo (0.015) para capturar las colas de las densidades\n","    visualizar_red_3d(E_A, E_B, Tiempos, nivel=0.015, frames=9)\n","\n","    # 3. Análisis Espectral de Fuerza (Campo C)\n","    freqs, C_ps_3d = espectro_fuerzas(C_final, dx)\n","\n","    # 4. Correlación y Entrelazamiento (Correlación Espacial A y B en el tiempo final)\n","    corr_AB_result = correlacion_AB(E_A[-1], E_B[-1])\n","\n","    # 5. Animación 3D (Se mostrará incrustada en el output del cuaderno)\n","    animacion_obj = animar_red_3d(E_A, E_B, Tiempos, nivel=0.015)\n","\n","    # Comando crucial para renderizar la animación en Colab/Jupyter\n","    # Se recomienda ejecutar esta línea en una celda separada para mejor rendimiento\n","    print(\"\\n--- ¡Animación Lista! ---\")\n","    print(\"El renderizado comenzará a continuación. Si el renderizado es lento,\")\n","    print(\"puedes reducir N_TIME o usar animacion_obj.save('universo_rqnt.mp4', fps=10).\")\n","\n","    # Devolver el objeto HTML para que Colab/Jupyter lo muestre\n","    display(HTML(animacion_obj.to_jshtml()))"],"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}],"execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"14eiHoazHtOqORospJw4FxGJzDMXtw0_f"},"id":"fT6MhPbtnpep","executionInfo":{"status":"ok","timestamp":1773680953954,"user_tz":360,"elapsed":27798,"user":{"displayName":"Edward Lopez","userId":"08504560914593961351"}},"outputId":"4995aed9-3b64-4f95-afcb-e30b98a0d2b7"}},{"cell_type":"code","source":["!pip install streamlit\n","import streamlit as st\n","import numpy as np\n","import plotly.graph_objects as go\n","\n","# --- ESTILOS PERSONALIZADOS ---\n","st.markdown(\"\"\"\n","    <style>\n","    .main { background-color: #0e1117; color: #ffffff; }\n","    .stTabs [data-baseweb=\"tab-list\"] { gap: 24px; }\n","    .stTabs [data-baseweb=\"tab\"] { height: 50px; white-space: pre-wrap; background-color: #1e2130; border-radius: 4px 4px 0 0; gap: 1px; padding-top: 10px; }\n","    .stTabs [aria-selected=\"true\"] { background-color: #4a4e69; }\n","    </style>\n","    \"\"\", unsafe_allow_html=True)\n","\n","# --- CONSTANTES DE ESCALADO R-QNT ---\n","G_CONST = 0.01\n","C_VACIO = 1.0\n","PASOS = 80\n","DT = 0.15\n","\n","# --- SECCIÓN 1: EL PAPER (Base Conceptual) ---\n","def mostrar_paper():\n","    st.title(\"📜 Paper Fundacional: Teoría R-QNT\")\n","    st.markdown(\"### Un Modelo de Torsión de Cartan y Estabilidad Borromea para la Unificación Geométrica\")\n","    st.caption(\"Autor: Edward Pérez López | Fase: Publicación y Validación Técnica\")\n","\n","    col1, col2 = st.columns(2)\n","\n","    with col1:\n","        st.info(\"#### I. El Postulado de la Triada\")\n","        st.write(\"\"\"\n","        La red no es un vacío, sino un flujo de tres componentes interconectados ($A, B, C$).\n","        - **Materia:** Nudos topológicos que 'secuestran' longitud de red.\n","        - **Gravedad:** Tensión de restitución elástica de la red.\n","        - **Tiempo:** Frecuencia de rotación local del nudo.\n","        \"\"\")\n","\n","    with col2:\n","        st.success(\"#### II. Geometría Borromea\")\n","        st.write(\"\"\"\n","        El nodo estable se define como un **Nudo Borromeo**.\n","        Si se corta un solo flujo, la integridad del nudo desaparece,\n","        explicando la aniquilación partícula-antipartícula como un desenredo topológico.\n","        \"\"\")\n","\n","    st.divider()\n","\n","    st.subheader(\"III. Base Matemática\")\n","    st.latex(r\"C_\\psi = \\sum (A + B + C) \\cdot e^{-i\\theta}\")\n","    st.write(\"Potencial de Coherencia: Define la visibilidad del nudo en el tejido del vacío.\")\n","\n","    st.latex(r\"M_R = \\oint_V \\tau \\, dV\")\n","    st.write(\"Masa Relacional: Integral del tensor de torsión de Cartan $\\tau$ sobre el volumen del nudo.\")\n","\n","# --- SECCIÓN 2: LÓGICA DE FOTONES (Vía A y B) ---\n","def propagar_luz(pos_inicial, masa_pos, modelo):\n","    trayectoria = [pos_inicial]\n","    pos = np.array(pos_inicial, dtype=float)\n","    vel = np.array([1.0, 0.0, 0.0]) # Velocidad inicial en X\n","\n","    for _ in range(PASOS):\n","        diff = masa_pos - pos\n","        dist = np.linalg.norm(diff)\n","\n","        if dist < 0.5: break # Colisión con el nudo\n","\n","        # Lógica de Velocidad Local (Efecto R-QNT)\n","        if modelo == \"Vía B: R-QNT (Variable)\":\n","            # En R-QNT, la densidad de red afecta la velocidad c local\n","            # c disminuye cerca de la masa por la 'fricción' de la torsión\n","            c_local = C_VACIO / (1 + (2.0 / (dist + 0.1)))\n","        else:\n","            c_local = C_VACIO # Einstein clásico (simplificado para visualización)\n","\n","        # Curvatura por Torsión (Aceleración hacia el centro)\n","        fuerza_torsion = (diff / (dist**3)) * G_CONST * 50\n","\n","        # Actualización de posición\n","        vel = (vel + fuerza_torsion * DT)\n","        # Normalizamos el avance por la c_local\n","        vel_norm = (vel / np.linalg.norm(vel)) * c_local\n","\n","        pos += vel_norm * DT\n","        trayectoria.append(pos.copy())\n","\n","    return np.array(trayectoria)\n","\n","# --- SECCIÓN 3: INTERFAZ DE USUARIO ---\n","st.set_page_config(page_title=\"R-QNT Simulator\", layout=\"wide\")\n","\n","tab1, tab2 = st.tabs([\"🎮 Simulador de Torsión\", \"📖 Paper Científico\"])\n","\n","with tab2:\n","    mostrar_paper()\n","\n","with tab1:\n","    st.sidebar.header(\"Configuración de Red\")\n","    via = st.sidebar.radio(\"Modelo Geométrico\",\n","                          [\"Vía A: Relatividad Estándar\", \"Vía B: R-QNT (Variable)\"])\n","\n","    masa_fuerza = st.sidebar.slider(\"Densidad del Nudo (Masa)\", 0.1, 5.0, 1.0)\n","\n","    st.subheader(f\"Simulación de Trayectorias: {via}\")\n","\n","    fig = go.Figure()\n","\n","    # Dibujar el Nudo Central (Masa)\n","    fig.add_trace(go.Scatter3d(\n","        x=[0], y=[0], z=[0],\n","        marker=dict(size=15 * masa_fuerza, color='red', opacity=0.8,\n","                    line=dict(width=2, color='white')),\n","        name=\"Nudo Borromeo (Masa)\"\n","    ))\n","\n","    # Generar múltiples rayos de luz\n","    offsets_y = np.linspace(-3, 3, 7)\n","    for y in offsets_y:\n","        camino = propagar_luz([-10, y, 0], np.array([0, 0, 0]), via)\n","\n","        # Calcular color basado en la velocidad local (redshift visual)\n","        fig.add_trace(go.Scatter3d(\n","            x=camino[:,0], y=camino[:,1], z=camino[:,2],\n","            mode='lines',\n","            line=dict(width=4, color='cyan' if via.startswith(\"Vía A\") else 'orange'),\n","            name=f\"Rayo y={y:.1f}\"\n","        ))\n","\n","    fig.update_layout(\n","        scene=dict(\n","            xaxis=dict(title=\"Espacio X\", backgroundcolor=\"rgb(20, 20, 20)\"),\n","            yaxis=dict(title=\"Espacio Y\", backgroundcolor=\"rgb(20, 20, 20)\"),\n","            zaxis=dict(title=\"Espacio Z\", backgroundcolor=\"rgb(20, 20, 20)\"),\n","            aspectmode='data'\n","        ),\n","        margin=dict(l=0, r=0, b=0, t=0),\n","        template=\"plotly_dark\"\n","    )\n","\n","    st.plotly_chart(fig, use_container_width=True)\n","\n","    st.write(\"\"\"\n","    **Observación Técnica:** En la **Vía B (R-QNT)**, notarás que los rayos no solo se curvan, sino que la distancia entre puntos\n","    disminuye al acercarse al centro. Esto representa la **contracción de la red** y la disminución de la velocidad de la luz\n","    debido a la densidad de torsión de Cartan.\n","    \"\"\")\n","\n","# --- SECCIÓN 4: EXPORTACIÓN ---\n","data_txt = f\"\"\"GEOMETRY_TYPE: BORROMEAN_TRIPLE_LINK\n","COMPONENTS: A, B, C\n","STABILITY_STATE: LOCKED\n","TORSION_COEFFICIENT: {G_CONST}\n","CURRENT_MODEL: {via}\n","EQUATION: M_R = Integral(Tau dV)\n","\"\"\"\n","st.download_button(\"📥 Descargar Metadata de Geometría (.txt)\", data_txt, file_name=\"rqnt_geometry.txt\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"51xuwrfxoImf","executionInfo":{"status":"ok","timestamp":1773681226042,"user_tz":360,"elapsed":19941,"user":{"displayName":"Edward Lopez","userId":"08504560914593961351"}},"outputId":"b6aaeb03-ef46-4710-8923-9086939029a9"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Collecting streamlit\n","  Downloading streamlit-1.55.0-py3-none-any.whl.metadata (9.8 kB)\n","Requirement already satisfied: altair!=5.4.0,!=5.4.1,<7,>=4.0 in /usr/local/lib/python3.12/dist-packages (from streamlit) (5.5.0)\n","Requirement already satis