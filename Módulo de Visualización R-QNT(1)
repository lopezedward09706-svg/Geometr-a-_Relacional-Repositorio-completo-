<main class=\"lg:col-span-2 space-y-8\">\n","                <!-- Gráfico Principal -->\n","                <div class=\"glass rounded-[2.5rem] p-8\">\n","                    <div class=\"flex justify-between items-center mb-6\">\n","                        <h3 class=\"text-lg font-bold\" id=\"viz-title\">Densidad de Probabilidad de Nudos</h3>\n","                        <div class=\"flex gap-2\">\n","                            <div class=\"w-2 h-2 rounded-full bg-emerald-500\"></div>\n","                            <div class=\"w-2 h-2 rounded-full bg-indigo-500\"></div>\n","                        </div>\n","                    </div>\n","                    <div class=\"chart-container\">\n","                        <canvas id=\"mainChart\"></canvas>\n","                    </div>\n","                </div>\n","\n","                <!-- Terminal de Logs / IA -->\n","                <div class=\"glass rounded-3xl p-6 h-64 flex flex-col\">\n","                    <div class=\"flex justify-between items-center mb-4 border-b border-white/5 pb-2\">\n","                        <span class=\"text-[10px] font-bold text-indigo-400 uppercase tracking-widest\">Auditoría IA R-QNT</span>\n","                        <span class=\"text-[10px] font-mono text-slate-600\" id=\"clock\"></span>\n","                    </div>\n","                    <div id=\"terminal\" class=\"flex-1 overflow-y-auto font-mono text-[11px] space-y-1 text-slate-400 scroll-custom\">\n","                        <div class=\"text-indigo-300\">> Esperando inicialización de fase...</div>\n","                    </div>\n","                </div>\n","            </main>\n","\n","        </div>\n","    </div>\n","\n","    <script>\n","        // --- ESTADO INICIAL ---\n","        let currentPhase = 1;\n","        let mainChart = null;\n","        const ctx = document.getElementById('mainChart').getContext('2d');\n","\n","        const phaseData = {\n","            1: {\n","                title: \"Exploración Numerológica\",\n","                icon: \"🎲\",\n","                controls: [\n","                    { id: \"kappa\", label: \"Tensión de Red (κ)\", min: 0.1, max: 5.0, step: 0.1, val: 1.0 },\n","                    { id: \"tau\", label: \"Torsión de Cartan (τ)\", min: 0.1, max: 2.0, step: 0.1, val: 0.5 },\n","                    { id: \"samples\", label: \"Muestras Monte Carlo\", min: 100, max: 5000, step: 100, val: 1000 }\n","                ],\n","                description: \"Simulando sistemas con parámetros libres para detectar patrones numéricos emergentes.\"\n","            },\n","            2: {\n","                title: \"Ajuste Basado en Física Real\",\n","                icon: \"⚖️\",\n","                controls: [\n","                    { id: \"electron\", label: \"Masa del Electrón (Restringida)\", min: 0.5, max: 0.52, step: 0.001, val: 0.511 },\n","                    { id: \"lambda\", label: \"Constante Cosmológica (Λ)\", min: 1e-53, max: 1e-51, step: 1e-53, val: 1.1e-52 },\n","                    { id: \"gauge\", label: \"Simetría Gauge (U1)\", min: 0.9, max: 1.0, step: 0.01, val: 1.0 }\n","                ],\n","                description: \"Restringiendo parámetros con datos históricos. Ajuste de invariancia de norma y conservación.\"\n","            },\n","            3: {\n","                title: \"Validación sin Ajustes\",\n","                icon: \"🔮\",\n","                controls: [\n","                    { id: \"energy\", label: \"Energía de Colisión (TeV)\", min: 1, max: 100, step: 1, val: 14 },\n","                    { id: \"vacuum\", label: \"Estabilidad del Vacío\", min: 0, max: 1, step: 0.1, val: 1 }\n","                ],\n","                description: \"Ejecución con parámetros fijos. Predicción de fenómenos no incluidos en el ajuste original.\"\n","            }\n","        };\n","\n","        // --- FUNCIONES DE UI ---\n","        function switchPhase(phase) {\n","            currentPhase = phase;\n","            document.querySelectorAll('.phase-tab').forEach((t, i) => {\n","                t.classList.toggle('active', i + 1 === phase);\n","            });\n","            renderControls();\n","            logIA(`Cambiando a FASE ${phase}: ${phaseData[phase].title}`);\n","            updateCharts();\n","        }\n","\n","        function renderControls() {\n","            const container = document.getElementById('controls-container');\n","            const data = phaseData[currentPhase];\n","            document.getElementById('phase-title').textContent = data.title;\n","            document.getElementById('phase-icon').textContent = data.icon;\n","            document.getElementById('viz-title').textContent = currentPhase === 3 ? \"Predicción vs Observación\" : \"Densidad de Probabilidad de Nudos\";\n","\n","            container.innerHTML = data.controls.map(c => `\n","                <div>\n","                    <div class=\"flex justify-between mb-2\">\n","                        <label class=\"text-[10px] font-bold text-slate-400 uppercase\">${c.label}</label>\n","                        <span class=\"font-mono text-xs text-emerald-500\" id=\"val-${c.id}\">${c.val}</span>\n","                    </div>\n","                    <input type=\"range\" min=\"${c.min}\" max=\"${c.max}\" step=\"${c.step}\" value=\"${c.val}\" \n","                        class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500\"\n","                        oninput=\"updateVal('${c.id}', this.value)\">\n","                </div>\n","            `).join('') + `<p class=\"text-[10px] text-slate-500 italic mt-4\">${data.description}</p>`;\n","        }\n","\n","        function updateVal(id, val) {\n","            document.getElementById(`val-${id}`).textContent = val;\n","        }\n","\n","        function logIA(msg) {\n","            const term = document.getElementById('terminal');\n","            const div = document.createElement('div');\n","            div.innerHTML = `<span class=\"text-emerald-500\">></span> ${msg}`;\n","            term.prepend(div);\n","        }\n","\n","        // --- LÓGICA DE SIMULACIÓN ---\n","        function runSimulation() {\n","            logIA(\"Iniciando motor de cómputo... verificando unitariedad.\");\n","            const mse = (Math.random() * 0.001).toFixed(6);\n","            document.getElementById('metric-mse').textContent = mse;\n","            \n","            setTimeout(() => {\n","                logIA(`Simulación de Fase ${currentPhase} completada.`);\n","                if(currentPhase === 1) logIA(\"Patrón emergente detectado en relación κ/τ.\");\n","                if(currentPhase === 2) logIA(\"Invariancia Gauge confirmada tras ajuste de masa del electrón.\");\n","                if(currentPhase === 3) logIA(\"PREDICCIÓN: Resonancia torsional detectada a 10.2 TeV.\");\n","                updateCharts();\n","            }, 800);\n","        }\n","\n","        // --- GRÁFICOS ---\n","        function updateCharts() {\n","            if(mainChart) mainChart.destroy();\n","            \n","            let datasets = [];\n","            let labels = Array.from({length: 20}, (_, i) => i);\n","\n","            if (currentPhase === 1) {\n","                datasets = [{\n","                    label: 'Barrido Paramétrico (Monte Carlo)',\n","                    data: labels.map(() => Math.random() * 50 + 20),\n","                    borderColor: '#6366f1',\n","                    backgroundColor: 'rgba(99, 102, 241, 0.1)',\n","                    fill: true,\n","                    tension: 0.4\n","                }];\n","            } else if (currentPhase === 2) {\n","                datasets = [{\n","                    label: 'Curva de Ajuste Físico',\n","                    data: labels.map(i => 80 - Math.pow(i - 10, 2) * 0.5),\n","                    borderColor: '#10b981',\n","                    borderWidth: 3,\n","                    pointRadius: 0,\n","                    tension: 0.4\n","                }];\n","            } else {\n","                datasets = [\n","                    {\n","                        label: 'Predicción Teórica',\n","                        data: labels.map(i => 50 + Math.sin(i/2) * 20),\n","                        borderColor: '#6366f1',\n","                        borderDash: [5, 5],\n","                        pointRadius: 0,\n","                        tension: 0.4\n","                    },\n","                    {\n","                        label: 'Resultado de Validación',\n","                        data: labels.map(i => 50 + Math.sin(i/2) * 20 + (Math.random() - 0.5) * 5),\n","                        borderColor: '#10b981',\n","                        backgroundColor: '#10b981',\n","                        pointRadius: 4,\n","                        showLine: false\n","                    }\n","                ];\n","            }\n","\n","            mainChart = new Chart(ctx, {\n","                type: currentPhase === 3 ? 'line' : 'line',\n","                data: { labels, datasets },\n","                options: {\n","                    responsive: true,\n","                    maintainAspectRatio: false,\n","                    plugins: { legend: { display: true, labels: { color: '#94a3b8', font: { size: 10 } } } },\n","                    scales: {\n","                        y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#64748b' } },\n","                        x: { grid: { display: false }, ticks: { color: '#64748b' } }\n","                    }\n","                }\n","            });\n","        }\n","\n","        // --- INICIALIZACIÓN ---\n","        setInterval(() => {\n","            document.getElementById('clock').textContent = new Date().toLocaleTimeString();\n","        }, 1000);\n","\n","        window.onload = () => {\n","            switchPhase(1);\n","        };\n","    </script>\n","</body>\n","</html>\n"]},"metadata":{}}]}],"metadata":{