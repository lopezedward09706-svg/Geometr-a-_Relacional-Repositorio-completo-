button>\n","                </div>\n","\n","                <div class=\"glass rounded-3xl p-6\">\n","                    <h3 class=\"text-[10px] font-bold text-slate-500 uppercase tracking-[0.3em] mb-4\">Métricas de Calidad</h3>\n","                    <div class=\"space-y-4 font-mono text-xs\">\n","                        <div class=\"flex justify-between\">\n","                            <span class=\"text-slate-400\">Error Cuadrático (MSE):</span>\n","                            <span id=\"metric-mse\" class=\"text-emerald-400\">0.00000</span>\n","                        </div>\n","                        <div class=\"flex justify-between\">\n","                            <span class=\"text-slate-400\">Estabilidad Numérica:</span>\n","                            <span id=\"metric-stability\" class=\"text-emerald-400\">OPTIMAL</span>\n","                        </div>\n","                        <div class=\"flex justify-between\">\n","                            <span class=\"text-slate-400\">Causalidad ($\\\\partial J = 0$):</span>\n","                            <span id=\"metric-causality\" class=\"text-emerald-400\">CONSERVED</span>\n","                        </div>\n","                    </div>\n","                </div>\n","            </aside>\n","\n","            <!-- PANEL DERECHO: VISUALIZACIÓN -->\n","            <main class=\"lg:col-span-2 space-y-8\">\n","                <!-- Gráfico Principal -->\n","                <div class=\"glass rounded-[2.5rem] p-8\">\n","                    <div class=\"flex justify-between items-center mb-6\">\n","                        <h3 class=\"text-lg font-bold\" id=\"viz-title\">Densidad de Probabilidad de Nudos</h3>\n","                        <div class=\"flex gap-2\">\n","                            <div class=\"w-2 h-2 rounded-full bg-emerald-500\"></div>\n","                            <div class=\"w-2 h-2 rounded-full bg-indigo-500\"></div>\n","                        </div>\n","                    </div>\n","                    <div class=\"chart-container\">\n","                        <canvas id=\"mainChart\"></canvas>\n","                    </div>\n","                </div>\n","\n","                <!-- Terminal de Logs / IA -->\n","                <div class=\"glass rounded-3xl p-6 h-64 flex flex-col\">\n","                    <div class=\"flex justify-between items-center mb-4 border-b border-white/5 pb-2\">\n","                        <span class=\"text-[10px] font-bold text-indigo-400 uppercase tracking-widest\">Auditoría IA R-QNT</span>\n","                        <span class=\"text-[10px] font-mono text-slate-600\" id=\"clock\"></span>\n","                    </div>\n","                    <div id=\"terminal\" class=\"flex-1 overflow-y-auto font-mono text-[11px] space-y-1 text-slate-400 scroll-custom\">\n","                        <div class=\"text-indigo-300\">> Esperando inicialización de fase...</div>\n","                    </div>\n","                </div>\n","            </main>\n","\n","        </div>\n","    </div>\n","\n","    <script>\n","        // --- ESTADO INICIAL ---\n","        let currentPhase = 1;\n","        let mainChart = null;\n","        const ctx = document.getElementById('mainChart').getContext('2d');\n","\n","        const phaseData = {\n","            1: {\n","                title: \"Exploración Numerológica\",\n","                icon: \"🎲\",\n","                controls: [\n","                    { id: \"kappa\", label: \"Tensión de Red (κ)\", min: 0.1, max: 5.0, step: 0.1, val: 1.0 },\n","                    { id: \"tau\", label: \"Torsión de Cartan (τ)\", min: 0.1, max: 2.0, step: 0.1, val: 0.5 },\n","                    { id: \"samples\", label: \"Muestras Monte Carlo\", min: 100, max: 5000, step: 100, val: 1000 }\n","                ],\n","                description: \"Simulando sistemas con parámetros libres para detectar patrones numéricos emergentes.\"\n","            },\n","            2: {\n","                title: 