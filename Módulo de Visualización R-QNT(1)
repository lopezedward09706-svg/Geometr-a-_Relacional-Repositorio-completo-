              if(currentPhase === 2) logIA(\"Invariancia Gauge confirmada tras ajuste de masa del electrón.\");\n","                if(currentPhase === 3) logIA(\"PREDICCIÓN: Resonancia torsional detectada a 10.2 TeV.\");\n","                updateCharts();\n","            }, 800);\n","        }\n","\n","        // --- GRÁFICOS ---\n","        function updateCharts() {\n","            if(mainChart) mainChart.destroy();\n","\n","            let datasets = [];\n","            let labels = Array.from({length: 20}, (_, i) => i);\n","\n","            if (currentPhase === 1) {\n","                datasets = [{\n","                    label: 'Barrido Paramétrico (Monte Carlo)',\n","                    data: labels.map(() => Math.random() * 50 + 20),\n","                    borderColor: '#6366f1',\n","                    backgroundColor: 'rgba(99, 102, 241, 0.1)',\n","                    fill: true,\n","                    tension: 0.4\n","                }];\n","            } else if (currentPhase === 2) {\n","                datasets = [{\n","                    label: 'Curva de Ajuste Físico',\n","                    data: labels.map(i => 80 - Math.pow(i - 10, 2) * 0.5),\n","                    borderColor: '#10b981',\n","                    borderWidth: 3,\n","                    pointRadius: 0,\n","                    tension: 0.4\n","                }];\n","            } else {\n","                datasets = [\n","                    {\n","                        label: 'Predicción Teórica',\n","                        data: labels.map(i => 50 + Math.sin(i/2) * 20),\n","                        borderColor: '#6366f1',\n","                        borderDash: [5, 5],\n","                        pointRadius: 0,\n","                        tension: 0.4\n","                    },\n","                    {\n","                        label: 'Resultado de Validación',\n","                        data: labels.map(i => 50 + Math.sin(i/2) * 20 + (Math.random() - 0.5) * 5),\n","                        borderColor: '#10b981',\n","                        backgroundColor: '#10b981',\n","                        pointRadius: 4,\n","                        showLine: false\n","                    }\n","                ];\n","            }\n","\n","            mainChart = new Chart(ctx, {\n","                type: currentPhase === 3 ? 'line' : 'line',\n","                data: { labels, datasets },\n","                options: {\n","                    responsive: true,\n","                    maintainAspectRatio: false,\n","                    plugins: { legend: { display: true, labels: { color: '#94a3b8', font: { size: 10 } } } },\n","                    scales: {\n","                        y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#64748b' } },\n","                        x: { grid: { display: false }, ticks: { color: '#64748b' } }\n","                    }\n","                }\n","            });\n","        }\n","\n","        // --- INICIALIZACIÓN ---\n","        setInterval(() => {\n","            document.getElementById('clock').textContent = new Date().toLocaleTimeString();\n","        }, 1000);\n","\n","        window.onload = () => {\n","            switchPhase(1);\n","        };\n","    </script>\n","</body>\n","</html>\n","\"\"\"\n","\n","display(HTML(html_content))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"cn2JT1VKoytX","executionInfo":{"status":"ok","timestamp":1773681422507,"user_tz":360,"elapsed":110,"user":{"displayName":"Edward Lopez","userId":"08504560914593961351"}},"outputId":"11db1c12-c612-41fa-d306-d7b25f995ef5"},"execution_count":6,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","<!DOCTYPE html>\n","<html lang=\"es\">\n","<head>\n","    <meta charset=\"UTF-8\">\n","    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n","    <title>R-QNT: Propuesta de Simulación v3.0